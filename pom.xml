<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.slytechs.sdk</groupId>
        <artifactId>sdk-parent</artifactId>
        <version>3.1.0-SNAPSHOT</version>
        <relativePath>../sdk-parent/pom.xml</relativePath>
    </parent>

    <artifactId>sdk-bom</artifactId>
    <packaging>pom</packaging>

    <name>Sly Technologies SDK BOM</name>
    <description>Bill of Materials for Sly Technologies SDK - centralizes version
        management for all OSS and commercial modules and third-party dependencies</description>
    <url>https://github.com/slytechs-repos/sdk-bom</url>

    <properties>
        <!-- Third-party dependency versions -->
        <junit.version>5.10.2</junit.version>
        <junit-platform.version>1.10.2</junit-platform.version>
        <cryptlex.version>3.32.0</cryptlex.version>
        <slf4j.version>2.0.17</slf4j.version>
        <logback.version>1.5.6</logback.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- ============================================================ -->
            <!-- SDK Core Modules                                              -->
            <!-- ============================================================ -->
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>sdk-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>sdk-common-systables</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ============================================================ -->
            <!-- Protocol Packs                                                -->
            <!-- ============================================================ -->
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>sdk-protocol-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>sdk-protocol-tcpip</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>sdk-protocol-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>sdk-protocol-infra</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ============================================================ -->
            <!-- jNetPcap (OSS - Maven Central)                               -->
            <!-- ============================================================ -->
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetpcap-sdk</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetpcap-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetpcap-bindings</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetpcap-examples</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ============================================================ -->
            <!-- jNetWorks OSS (Maven Central)                                -->
            <!-- ============================================================ -->
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetworks-sdk</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetworks-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetworks-pcap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetworks-file-pcap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetworks-examples</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ============================================================ -->
            <!-- jNetWorks Commercial (maven.slytechs.com)                    -->
            <!-- See https://www.slytechs.com/products for access              -->
            <!-- ============================================================ -->
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetworks-dpdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetworks-ntapi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetdpdk-bindings</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slytechs.sdk</groupId>
                <artifactId>jnetntapi-bindings</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ============================================================ -->
            <!-- Third-party dependencies                                      -->
            <!-- ============================================================ -->

            <!-- JUnit 5 - import BOM for full platform alignment -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- License management -->
            <dependency>
                <groupId>com.cryptlex.lexactivator</groupId>
                <artifactId>lexactivator</artifactId>
                <version>${cryptlex.version}</version>
            </dependency>

            <!-- Logging facade - consumers provide their own implementation -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Logback - for examples and development/testing only -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>